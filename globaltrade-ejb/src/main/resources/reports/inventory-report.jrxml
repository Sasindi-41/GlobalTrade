                        + new java.text.SimpleDateFormat("yyyy-MM-dd")
                            .format($P{START_DATE})
                        + " to "
                        + new java.text.SimpleDateFormat("yyyy-MM-dd")
                            .format($P{END_DATE})
                    ]]>
                </textFieldExpression>

            </textField>


        </band>

    </title>

