<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://jasperreports.sourceforge.net/jasperreports
            http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="inventory-report"
        pageWidth="842"
        pageHeight="595"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30"
        uuid="7d2a4c61-9b32-4e58-a7d4-2c8f1b6e9002">

    <parameter
            name="START_DATE"
            class="java.sql.Date"/>

    <parameter
            name="END_DATE"
            class="java.sql.Date"/>

    <parameter
            name="REPORT_TYPE"
            class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
            SELECT
                i.product_code,
                i.product_name,
                i.quantity,
                i.reorder_level,

                CASE
                    WHEN i.quantity <= i.reorder_level
                        THEN 'LOW STOCK'
                    ELSE 'IN STOCK'
                END AS stock_status,

                v.company_name AS vendor_name,
                w.name AS warehouse_name,
                i.last_updated

            FROM inventory i

            INNER JOIN vendors v
                ON i.vendors_id = v.id

            INNER JOIN warehouse w
                ON i.warehouse_id = w.id

            WHERE i.last_updated >= $P{START_DATE}

              AND i.last_updated <
                  DATE_ADD(
                      $P{END_DATE},
                      INTERVAL 1 DAY
                  )

            ORDER BY
                i.last_updated DESC,
                i.product_name ASC
        ]]>
    </queryString>

    <field
            name="product_code"
            class="java.lang.String"/>

    <field
            name="product_name"
            class="java.lang.String"/>

    <field
            name="quantity"
            class="java.lang.Integer"/>

    <field
            name="reorder_level"
            class="java.lang.Integer"/>

    <field
            name="stock_status"
            class="java.lang.String"/>

    <field
            name="vendor_name"
            class="java.lang.String"/>

    <field
            name="warehouse_name"
            class="java.lang.String"/>

    <field
            name="last_updated"
            class="java.sql.Timestamp"/>

    <title>

        <band
                height="90"
                splitType="Stretch">

            <staticText>

                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="28"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="20"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[GLOBALTRADE LOGISTICS]]>
                </text>

            </staticText>


            <staticText>

                <reportElement
                        x="0"
                        y="32"
                        width="782"
                        height="22"/>

                <textElement
