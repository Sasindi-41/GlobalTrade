                        verticalAlignment="Middle">

                    <font size="7"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{entity_id}]]>
                </textFieldExpression>

            </textField>

            <textField
                    isStretchWithOverflow="true">

                <reportElement
                        x="455"
                        y="0"
                        width="110"
                        height="45"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">

                    <font size="6"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{details} == null
                        ? ""
                        : $F{details}
                    ]]>
                </textFieldExpression>

            </textField>

            <textField
                    isStretchWithOverflow="true">

                <reportElement
                        x="565"
                        y="0"
                        width="72"
                        height="45"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Left"
                        verticalAlignment="Middle">

                    <font size="6"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{old_value} == null
                        ? "-"
                        : $F{old_value}
                    ]]>
                </textFieldExpression>

            </textField>

            <textField
                    isStretchWithOverflow="true">

                <reportElement
                        x="637"
                        y="0"
                        width="145"
                        height="45"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
