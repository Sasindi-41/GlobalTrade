                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[ID]]>
                </text>

            </staticText>


            <staticText>

                <reportElement
                        x="35"
                        y="0"
                        width="100"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
