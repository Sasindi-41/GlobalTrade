                        width="85"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[User]]>
                </text>

            </staticText>


            <staticText>

                <reportElement
                        x="220"
                        y="0"
                        width="85"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Action]]>
                </text>

            </staticText>

            <staticText>

                <reportElement
                        x="305"
                        y="0"
                        width="90"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Entity Type]]>
                </text>

            </staticText>


            <staticText>

                <reportElement
                        x="395"
                        y="0"
                        width="60"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Entity ID]]>
                </text>

            </staticText>

            <staticText>

                <reportElement
                        x="455"
                        y="0"
                        width="110"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Details]]>
                </text>

            </staticText>

            <staticText>

                <reportElement
                        x="565"
