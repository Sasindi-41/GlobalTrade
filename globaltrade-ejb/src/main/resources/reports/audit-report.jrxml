                        width="72"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[Old Value]]>
                </text>

            </staticText>

            <staticText>

                <reportElement
                        x="637"
                        y="0"
                        width="145"
                        height="38"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="8"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[New Value]]>
                </text>

            </staticText>

        </band>

    </columnHeader>

    <detail>

        <band
                height="45"
                splitType="Stretch">


            <textField>

                <reportElement
                        x="0"
                        y="0"
                        width="35"
                        height="45"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font size="7"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[$F{id}]]>
                </textFieldExpression>

            </textField>


            <textField>

                <reportElement
                        x="35"
                        y="0"
                        width="100"
                        height="45"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
