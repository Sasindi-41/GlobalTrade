<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://jasperreports.sourceforge.net/jasperreports
            http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="audit-report"
        pageWidth="842"
        pageHeight="595"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="25"
        bottomMargin="25"
        uuid="7e7d7f12-3d1f-4d8c-a0f1-9b3e7d4c52a1">

    <parameter
            name="START_DATE"
            class="java.sql.Date"/>

    <parameter
            name="END_DATE"
            class="java.sql.Date"/>

    <parameter
            name="REPORT_TYPE"
            class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
            SELECT
                a.id,
                a.action,
                a.old_value,
                a.new_value,
                a.timestamp,
                a.details,
                a.entity_id,

                u.username,

                et.name AS entity_type

            FROM audit_logs a

            INNER JOIN users u
                ON a.users_id = u.id

            INNER JOIN entity_type et
                ON a.entity_type_id = et.id

            WHERE a.timestamp >= $P{START_DATE}

              AND a.timestamp <
                  DATE_ADD(
                      $P{END_DATE},
                      INTERVAL 1 DAY
                  )

            ORDER BY
                a.timestamp DESC,
                a.id DESC
        ]]>
    </queryString>

    <field
            name="id"
            class="java.lang.Integer"/>

    <field
            name="action"
            class="java.lang.String"/>

    <field
            name="old_value"
            class="java.lang.String"/>

    <field
            name="new_value"
            class="java.lang.String"/>

    <field
            name="timestamp"
            class="java.sql.Timestamp"/>

    <field
            name="details"
            class="java.lang.String"/>

    <field
            name="entity_id"
            class="java.lang.Integer"/>

    <field
            name="username"
            class="java.lang.String"/>

    <field
            name="entity_type"
            class="java.lang.String"/>

    <title>

        <band
                height="100"
                splitType="Stretch">


            <staticText>

                <reportElement
                        x="0"
                        y="0"
                        width="782"
                        height="30"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="20"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[GLOBALTRADE LOGISTICS]]>
                </text>

            </staticText>


            <staticText>

                <reportElement
                        x="0"
                        y="34"
                        width="782"
                        height="24"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="15"
                            isBold="true"/>

                </textElement>

                <text>
                    <![CDATA[AUDIT LOG REPORT]]>
                </text>

            </staticText>


            <textField>

                <reportElement
                        x="0"
                        y="66"
                        width="782"
                        height="18"/>

                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                    <font
                            size="9"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        "Reporting Period: "
                        + new java.text.SimpleDateFormat("yyyy-MM-dd")
                            .format($P{START_DATE})
                        + " to "
                        + new java.text.SimpleDateFormat("yyyy-MM-dd")
                            .format($P{END_DATE})
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </title>


    <columnHeader>

        <band
                height="38"
                splitType="Stretch">


            <staticText>

                <reportElement
                        x="0"
                        y="0"
                        width="35"
