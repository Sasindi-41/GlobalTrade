                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        $F{new_value} == null
                        ? "-"
                        : $F{new_value}
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </detail>

    <pageFooter>

        <band height="30">


            <textField>

                <reportElement
                        x="0"
                        y="5"
                        width="450"
                        height="18"/>

                <textElement
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        "Generated by GlobalTrade Reporting System"
                    ]]>
                </textFieldExpression>

            </textField>


            <textField>

                <reportElement
                        x="600"
                        y="5"
                        width="182"
                        height="18"/>

                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">

                    <font size="8"/>

                </textElement>

                <textFieldExpression>
                    <![CDATA[
                        "Page " + $V{PAGE_NUMBER}
                    ]]>
                </textFieldExpression>

            </textField>

        </band>

    </pageFooter>

    <noData>

        <band height="70">

            <staticText>

                <reportElement
                        x="0"
