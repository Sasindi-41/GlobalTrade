<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://jasperreports.sourceforge.net/jasperreports
            http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="route-report"
        pageWidth="842"
        pageHeight="595"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30"
        uuid="7b8e4c32-91a6-4d25-b7e3-5f9c2a810004">

    <parameter
            name="START_DATE"
            class="java.sql.Date"/>

    <parameter
            name="END_DATE"
            class="java.sql.Date"/>

    <parameter
            name="REPORT_TYPE"
            class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
            SELECT
                r.id,
                s.tracking_number,
                v.company_name AS vendor_name,

                CONCAT(
                    COALESCE(oa.line_1, ''),
                    CASE
                        WHEN oa.line_2 IS NOT NULL
                             AND oa.line_2 <> ''
                        THEN CONCAT(', ', oa.line_2)
                        ELSE ''
                    END,
                    CASE
                        WHEN oc.name IS NOT NULL
                        THEN CONCAT(', ', oc.name)
                        ELSE ''
                    END,
                    CASE
                        WHEN oco.name IS NOT NULL
                        THEN CONCAT(', ', oco.name)
                        ELSE ''
                    END,
                    CASE
                        WHEN oa.postal_code IS NOT NULL
                             AND oa.postal_code <> ''
                        THEN CONCAT(' - ', oa.postal_code)
                        ELSE ''
                    END
                ) AS origin_address,

                CONCAT(
                    COALESCE(da.line_1, ''),
                    CASE
                        WHEN da.line_2 IS NOT NULL
                             AND da.line_2 <> ''
                        THEN CONCAT(', ', da.line_2)
                        ELSE ''
                    END,
                    CASE
                        WHEN dc.name IS NOT NULL
                        THEN CONCAT(', ', dc.name)
                        ELSE ''
                    END,
                    CASE
                        WHEN dco.name IS NOT NULL
                        THEN CONCAT(', ', dco.name)
                        ELSE ''
                    END,
                    CASE
                        WHEN da.postal_code IS NOT NULL
                             AND da.postal_code <> ''
                        THEN CONCAT(' - ', da.postal_code)
                        ELSE ''
                    END
                ) AS destination_address,

                r.estimated_distance,
                r.estimated_duration,
                r.optimization_score,
                r.recommended_route,
                r.calculated_at

            FROM route_optimizations r

            INNER JOIN shipments s
                ON r.shipments_id = s.id

            INNER JOIN vendors v
                ON s.vendors_id = v.id

            INNER JOIN addresses oa
                ON r.origin_address = oa.id

            INNER JOIN city oc
                ON oa.city_id = oc.id

            INNER JOIN country oco
                ON oa.country_id = oco.id

            INNER JOIN addresses da
                ON r.destination_address = da.id

            INNER JOIN city dc
                ON da.city_id = dc.id

            INNER JOIN country dco
                ON da.country_id = dco.id

            WHERE r.calculated_at >= $P{START_DATE}

              AND r.calculated_at <
                  DATE_ADD(
                      $P{END_DATE},
                      INTERVAL 1 DAY
                  )

            ORDER BY
                r.calculated_at DESC,
                r.optimization_score DESC
        ]]>
    </queryString>

    <field
            name="id"
            class="java.lang.Integer"/>

    <field
            name="tracking_number"
            class="java.lang.String"/>

    <field
            name="vendor_name"
            class="java.lang.String"/>

    <field
            name="origin_address"
            class="java.lang.String"/>

    <field
            name="destination_address"
            class="java.lang.String"/>

    <field
            name="estimated_distance"
            class="java.math.BigDecimal"/>

    <field
            name="estimated_duration"
            class="java.lang.Integer"/>

    <field
            name="optimization_score"
            class="java.math.BigDecimal"/>

    <field
            name="recommended_route"
            class="java.lang.String"/>

    <field
            name="calculated_at"
            class="java.sql.Timestamp"/>

