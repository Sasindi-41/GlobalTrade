<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        name="alert-report"
        pageWidth="595"
        pageHeight="842"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20"
        whenNoDataType="NoDataSection"
        uuid="7f4e8d3a-2c91-4a76-b5e2-91d6f8c34721">

    <parameter
            name="START_DATE"
            class="java.sql.Date"/>

    <parameter
            name="END_DATE"
            class="java.sql.Date"/>

    <parameter
            name="REPORT_TYPE"
            class="java.lang.String"/>


    <queryString language="SQL">
        <![CDATA[
            SELECT
                a.id,
                a.message,
                a.created_at,
                a.resolved_at,

                sh.tracking_number,

                v.vendor_code,
                v.company_name,

                i.product_code,
                i.product_name,

                at.name AS alert_type,
                sev.name AS severity_name,
                ast.name AS alert_status

            FROM alerts a

            INNER JOIN shipments sh
                ON a.shipments_id = sh.id

            INNER JOIN vendors v
                ON a.vendors_id = v.id

            INNER JOIN inventory i
                ON a.inventory_id = i.id

            INNER JOIN alert_type at
                ON a.alert_type_id = at.id

            INNER JOIN severity sev
                ON a.severity_id = sev.id

            INNER JOIN alert_status ast
                ON a.alert_status_id = ast.id

            WHERE a.created_at >= $P{START_DATE}

              AND a.created_at <
                  DATE_ADD(
                      $P{END_DATE},
                      INTERVAL 1 DAY
                  )

            ORDER BY
                a.created_at DESC,
                sev.name ASC,
                v.company_name ASC
        ]]>
    </queryString>


    <field
            name="id"
            class="java.lang.Integer"/>

    <field
            name="message"
            class="java.lang.String"/>

    <field
            name="created_at"
            class="java.sql.Timestamp"/>

    <field
            name="resolved_at"
            class="java.sql.Timestamp"/>

    <field
            name="tracking_number"
            class="java.lang.String"/>

    <field
            name="vendor_code"
            class="java.lang.String"/>

    <field
            name="company_name"
            class="java.lang.String"/>

    <field
            name="product_code"
            class="java.lang.String"/>

    <field
            name="product_name"
            class="java.lang.String"/>

    <field
            name="alert_type"
            class="java.lang.String"/>

    <field
            name="severity_name"
            class="java.lang.String"/>

    <field
            name="alert_status"
            class="java.lang.String"/>

    <title>

